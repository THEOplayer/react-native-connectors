+// swift-tools-version: 6.1
+import Foundation
+import PackageDescription
+
+// Resolve RN's generated alias back to the installed, unscoped npm package.
+let packageDirectory = URL(fileURLWithPath: Context.packageDirectory).resolvingSymlinksInPath()
+let reactNativePath = packageDirectory.appendingPathComponent("../../ios/build/xcframeworks").standardizedFileURL.path
+
+let package = Package(
+    name: "RNDeviceInfo",
+    platforms: [.iOS("16.0"), .tvOS("15.1")],
+    products: [
+        .library(name: "RNDeviceInfo", targets: ["RNDeviceInfo"]),
+    ],
+    dependencies: [
+        .package(name: "ReactNative", path: reactNativePath),
+    ],
+    targets: [
+        .target(
+            name: "RNDeviceInfo",
+            dependencies: [
+                .product(name: "ReactHeaders", package: "ReactNative"),
+                .product(name: "ReactNativeHeaders", package: "ReactNative"),
+                .product(name: "ReactNativeDependenciesHeaders", package: "ReactNative"),
+            ],
+            path: ".",
+            sources: [
+                "ios/RNDeviceInfo/DeviceUID.h",
+                "ios/RNDeviceInfo/DeviceUID.m",
+                "ios/RNDeviceInfo/EnvironmentUtil.h",
+                "ios/RNDeviceInfo/EnvironmentUtil.m",
+                "ios/RNDeviceInfo/RNDeviceInfo.h",
+                "ios/RNDeviceInfo/RNDeviceInfo.m",
+            ],
+            resources: [.copy("ios/PrivacyInfo.xcprivacy")],
+            publicHeadersPath: "ios/RNDeviceInfo",
+            cSettings: [
+                .headerSearchPath("ios/RNDeviceInfo"),
+                .headerSearchPath("."),
+                .unsafeFlags(["-include", "react-native-spm-prefix.h"]),
+            ],
+            linkerSettings: [
+                .linkedFramework("UIKit"),
+                .linkedFramework("Foundation"),
+                .linkedFramework("CoreGraphics"),
+            ]
+        ),
+    ],
+    cxxLanguageStandard: .cxx20
+)
